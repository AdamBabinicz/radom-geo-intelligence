# Primary AI provider (Gemini) — pricing sync, market structuring, Strategist & Synthesis
GEMINI_API_KEY=

# Optional secondary AI provider (true cross-provider Devil's Advocate Critic in AI Council)
# Free & fast tier available at https://console.groq.com/keys (uses llama-3.3-70b-versatile)
GROQ_API_KEY=
# Optional OpenAI fallback critic (used if GROQ_API_KEY is empty)
OPENAI_API_KEY=

# Optional Serper.dev API key for Google Search + Google Maps Business Profile discovery
SERPER_API_KEY=

# Optional: set to "true" to prioritize Gemini Google Search Grounding before Serper
ENABLE_GEMINI_SEARCH_GROUNDING=

# Optional Atlassian Cloud REST integration (live Jira Epics/Tasks & Confluence Playbooks)
ATLASSIAN_BASE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
ATLASSIAN_CONFLUENCE_SPACE_KEY=northstarg
ATLASSIAN_JIRA_PROJECT_KEY=KAN